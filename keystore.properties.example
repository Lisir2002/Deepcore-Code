# 正式签名配置模板
#
# 用法：复制为同目录下的 keystore.properties（已在 .gitignore 中），填入真实值。
# 仓库里只提交本模板，任何真实密钥/口令都不应进入版本库。
#
#   cp keystore.properties.example keystore.properties
#   chmod 600 keystore.properties
#
# 读取优先级：环境变量 > keystore.properties。
# 本地开发用文件，CI 用环境变量，两条路互不影响。

# keystore 文件路径。可以是仓库外的绝对路径（推荐，物理隔离更安全）
STORE_FILE=/absolute/path/to/deepcode-release.jks

# keystore 口令
STORE_PASSWORD=

# 密钥别名
KEY_ALIAS=deepcode

# 密钥口令。PKCS12 下必须与 STORE_PASSWORD 相同，
# 否则 jarsigner / AGP 会报 "not a private key"（实测踩过）。
KEY_PASSWORD=
